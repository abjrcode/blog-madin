# Only content-hashed file names may be cached forever: main.g.css/js keep a fixed
# path, so a request racing a deploy could pin an old copy at the edge.
/processed_images/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
