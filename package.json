{
  "name": "blog-madin",
  "private": true,
  "type": "module",
  "author": {
    "name": "Ibrahim Najjar",
    "url": "https://madin.dev"
  },
  "description": "Madin blog",
  "repository": {
    "type": "git",
    "url": "git@github.com:abjrcode/blog-madin.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "concurrently --restart-tries 3 --restart-after 500 -c blue,magenta,yellow -n TAILWIND,ESBUILD,ZOLA npm:dev:css npm:dev:js npm:dev:zola",
    "dev:zola": "zola --root ./blog serve",
    "dev:css": "tailwindcss -i bundles/dev.css -o blog/static/main.g.css --watch",
    "dev:js": "npm run js -- --watch",
    "build": "npm run build:css && npm run build:js && npm run build:zola",
    "build:zola": "zola --root ./blog build",
    "build:css": "npm run css -- --minify",
    "build:js": "npm run js -- --minify",
    "css": "tailwindcss -i bundles/main.css -o blog/static/main.g.css",
    "js": "esbuild bundles/main.js --outfile=blog/static/main.g.js --bundle --format=iife --target=es2022",
    "svg": "svgo --multipass -r -f blog/content"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-debug-screens": "^3.0.1",
    "wrangler": "^4.147.0"
  }
}
